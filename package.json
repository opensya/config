{
  "name": "@opensya/config",
  "version": "0.30.0",
  "private": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/opensya/config.git"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "browser": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./browser": {
      "types": "./dist/index.d.ts",
      "import": "./dist/browser/index.mjs",
      "default": "./dist/browser/index.mjs"
    },
    "./node": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "default": "./dist/index.mjs"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://npm.pkg.github.com"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "rslib build",
    "dev": "rslib build --watch",
    "dev0": "tsx --watch ./src/dev",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "opensya",
    "config"
  ],
  "license": "ISC",
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@changesets/cli": "^2.31.0",
    "@rslib/core": "^0.21.3",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^25.6.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2"
  },
  "dependencies": {
    "@opensya/share": "latest"
  },
  "packageManager": "pnpm@10.32.1"
}
